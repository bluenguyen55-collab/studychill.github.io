<body class="text-slate-800 antialiased">
  <div id="root"></div>

  <script type="text/babel">
    const { useState, useEffect, useRef } = React;

    // --- HELPER COMPONENT FOR LUCIDE ICONS ---
    const Icon = ({ name, size = 18, className = "" }) => {
      const iconRef = useRef(null);

      useEffect(() => {
        if (iconRef.current && window.lucide) {
          iconRef.current.innerHTML = '';
          const iconElement = document.createElement('i');
          iconElement.setAttribute('data-lucide', name);
          iconRef.current.appendChild(iconElement);
          window.lucide.createIcons({
            root: iconRef.current,
            attrs: {
              width: size,
              height: size,
              class: className
            }
          });
        }
      }, [name, size, className]);

      return <span ref={iconRef} className="inline-flex items-center justify-center shrink-0"></span>;
    };

    // --- DATE HELPERS ---
    const getTodayKey = (offsetDays = 0) => {
      const d = new Date();
      d.setDate(d.getDate() + offsetDays);
      const year = d.getFullYear();
      const month = String(d.getMonth() + 1).padStart(2, '0');
      const day = String(d.getDate()).padStart(2, '0');
      return `${year}-${month}-${day}`;
    };

    const getShortDayLabel = (dateStr) => {
      const [y, m, d] = dateStr.split('-').map(Number);
      const dateObj = new Date(y, m - 1, d);
      const days = ['CN', 'T2', 'T3', 'T4', 'T5', 'T6', 'T7'];
      return `${days[dateObj.getDay()]} (${d}/${m})`;
    };

    // --- DEFAULT INITIAL DATA ---
    const DEFAULT_SUBJECTS = [
      { id: 'sub-1', name: 'Toán học', color: 'bg-blue-500', textColor: 'text-blue-700', bgLight: 'bg-blue-50' },
